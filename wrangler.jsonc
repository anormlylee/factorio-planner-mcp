{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "factorio-planner-mcp",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "build": { "command": "npm run prepare:worker" },
  "alias": {
    "#catalog-data": "./src/data-worker.js",
    "#solver": "./src/solver-worker.js"
  },
  "routes": [{ "pattern": "factorio-mcp.anormlylee.com", "custom_domain": true }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "ratelimits": [{
    "name": "MCP_RATE_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 120, "period": 60 }
  }]
}
